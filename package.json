{
  "name": "skyesthingy",
  "version": "1.0.0",
  "description": "Sorts what you and a few friends listen to on Spotify into genre playlists. Runs on Cloudflare Workers Free.",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --test-scheduled",
    "deploy": "wrangler d1 migrations apply autolist --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply autolist --local",
    "db:migrate:remote": "wrangler d1 migrations apply autolist --remote"
  },
  "author": "Pete Thambundit",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "private": true
}
